# FinTech GOAT — Environment Variables
# ======================================
# Copy this to .env and fill in the values.
# Never commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   docker compose up --build

# ── OpenAI ─────────────────────────────────────────────────────────────────
# Used by: orchestrator agents, mcp_server llm_backend (dynamic import)
OPENAI_API_KEY=sk-...

# ── Anthropic ──────────────────────────────────────────────────────────────
# Used by: model_provider.py (SBOM complexity test alias chain)
ANTHROPIC_API_KEY=sk-ant-...

# ── Azure OpenAI ───────────────────────────────────────────────────────────
# Used by: middleware/_llm_gate.py (LLMGuard), model_provider.py (AzureChatOpenAI)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-05-13

# ── Azure Application Insights ─────────────────────────────────────────────
# Optional — telemetry disabled when not set
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# ── Celery / Redis ─────────────────────────────────────────────────────────
# Used by: tasks.py for async fund transfer processing
REDIS_URL=redis://localhost:6379/0

# ── Database ───────────────────────────────────────────────────────────────
# SQLite for local dev; swap to PostgreSQL in production
DATABASE_URL=sqlite:///./cipher_bank.db

# ── Orchestrator ───────────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:8098

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# AI provider for client-side SBOM complexity test files
# One of: openai | anthropic | azure
VITE_AI_PROVIDER=openai
VITE_AI_MODEL=gpt-4o
VITE_OPENAI_API_KEY=sk-...
VITE_ANTHROPIC_API_KEY=sk-ant-...
VITE_AZURE_OPENAI_API_KEY=
VITE_AZURE_OPENAI_ENDPOINT=
VITE_AZURE_OPENAI_DEPLOYMENT=gpt-4o
