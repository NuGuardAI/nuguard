# Phlox test target — environment template
# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ── Phlox (Docker) runtime config ──────────────────────────────────────────
# Required in Docker mode — SQLCipher passphrase for the local clinical DB.
# Generate with: openssl rand -hex 32
DB_ENCRYPTION_KEY=

# CORS origins Phlox will accept. "*" disables credentialed requests.
ALLOWED_ORIGINS=*

# Port Phlox binds to inside the container (also the host port in docker-compose.yml).
PORT=5000
SERVER_HOST=0.0.0.0

# Optional — reverse-proxy auth (leave disabled for local/test use; see README).
# PROXY_AUTH_ENABLED=false
# PROXY_AUTH_USER_HEADER=X-Forwarded-User
# PROXY_AUTH_ALLOWED_USERS=

# ── LLM backend Phlox uses for note generation / chat / tool-calling ───────
# Phlox has no env-var hook for its model endpoint — it is configured once via
# Settings -> Model Settings in the running app (see README "First-run setup").
# These values are only here as a reminder of what you'll paste into that UI.
# OPENAI_API_KEY is also consumed directly by NuGuard's own LLM client when
# nuguard.yaml's llm.model is set to an "openai/..." LiteLLM model string.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── NuGuard target auth (Phlox ships with no built-in auth by default) ─────
# Leave unset for an open local/test instance (target.auth.type: none in nuguard.yaml).
# Only needed if you put Phlox behind PROXY_AUTH_ENABLED / a reverse proxy.
# APP_USERNAME=
# APP_PASSWORD=

# ── GitHub (optional) ───────────────────────────────────────────────────────
# Only needed if nuguard sbom generate hits GitHub API rate limits while
# scanning https://github.com/bloodworks-io/phlox.
# GITHUB_TOKEN=
