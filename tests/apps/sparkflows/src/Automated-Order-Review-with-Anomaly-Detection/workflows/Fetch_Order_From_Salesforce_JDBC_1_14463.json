{
  "name": "Fetch Order From Salesforce JDBC 1",
  "uuid": "cd8b2373-29b2-4ea4-98fc-649a216cf96d",
  "category": "Order Review",
  "description": "Fetches one order from Salesforce by order_id, flattens nested structs, inserts row into orders_jdbc with review_status=Processing. Append mode (initial insert).",
  "parameters": "--var order_id=${order_id} --var execution_id=${execution_id}",
