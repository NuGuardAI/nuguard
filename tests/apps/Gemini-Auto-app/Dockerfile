FROM node:20-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_GEMINI_API_KEY
ARG VITE_GEMINI_MODEL
ARG VITE_GOOGLE_MAPS_API_KEY
ARG GOOGLE_MAPS_PLATFORM_KEY
ARG OPENWEATHER_API_KEY
ARG VITE_GOOGLE_OAUTH_CLIENT_ID
ARG VITE_GOOGLE_PROJECT_ID
ENV VITE_GEMINI_API_KEY=$VITE_GEMINI_API_KEY
ENV VITE_GEMINI_MODEL=$VITE_GEMINI_MODEL
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY
ENV GOOGLE_MAPS_PLATFORM_KEY=$GOOGLE_MAPS_PLATFORM_KEY
ENV OPENWEATHER_API_KEY=$OPENWEATHER_API_KEY
ENV VITE_GOOGLE_OAUTH_CLIENT_ID=$VITE_GOOGLE_OAUTH_CLIENT_ID
ENV VITE_GOOGLE_PROJECT_ID=$VITE_GOOGLE_PROJECT_ID
RUN npm run build

FROM node:20-slim
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY package*.json ./
COPY server.ts ./
COPY agent ./agent
RUN npm ci --omit=dev
EXPOSE 3000
CMD ["npx", "tsx", "server.ts"]
