# GEMINI_API_KEY: Required for Gemini AI API calls.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=

# GOOGLE_MAPS_PLATFORM_KEY: Required for real Google Maps integrations.
GOOGLE_MAPS_PLATFORM_KEY=""

# OPENWEATHER_API_KEY: Required for real-time weather updates.
OPENWEATHER_API_KEY=""

# VITE_SPOTIFY_CLIENT_ID: Optional, enables real Spotify integration logic.
VITE_SPOTIFY_CLIENT_ID=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_PROJECT_ID=

# JWT_SECRET: Secret used to sign session tokens. Use a long random string in production.
JWT_SECRET=

# OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET: Server-side GCP OAuth 2.0 credentials.
# Used to verify the audience of Google access tokens and ID tokens on the server.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
