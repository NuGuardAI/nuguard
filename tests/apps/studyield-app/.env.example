# Studyield test target — environment template
# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ── Studyield (Docker Compose) runtime config ──────────────────────────────
# Ports the upstream docker-compose.yml binds on the host (see repo/docker-compose.yml
# after ./clone-studyield.sh runs). Kept as env vars so nuguard.yaml, the deploy
# scripts, and Studyield's own .env.docker all agree on the same values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studyield_dev
POSTGRES_PORT=5432

REDIS_PORT=6379

QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=studyield_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

BACKEND_PORT=3010
FRONTEND_PORT=5189

# Required — JWT signing secrets (min 32 chars). Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── AI backend Studyield uses (RAG chat, exam clone, multi-agent solver, etc.) ──
# Studyield reads these directly from backend/.env — see
# https://github.com/studyield/studyield/blob/main/backend/.env.example
# At least one of OPENROUTER_API_KEY / OPENAI_API_KEY is required for AI features.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── NuGuard target auth (Studyield requires a real account — login_flow) ───
# Create a test account after first boot, then set these so NuGuard's
# login_flow auth (see nuguard.yaml) can obtain a JWT before running scenarios.
APP_USERNAME=
APP_PASSWORD=

# ── NuGuard's own LLM (scenario generation / judging) ───────────────────────
# Reuse the same LiteLLM-compatible credentials already configured for other
# NuGuard test targets (see ../phlox-app/.env) rather than duplicating secrets.
# OPENAI_API_KEY above is also consumed directly by nuguard.yaml's llm.model
# when set to an "openai/..." LiteLLM model string.
# AZURE_DEEPSEEK_KEY=
# AZURE_DEEPSEEK_ENDPOINT=
# AZURE_DEEPSEEK_MODEL_NAME=

# ── GitHub (optional) ───────────────────────────────────────────────────────
# Only needed if nuguard sbom generate hits GitHub API rate limits while
# scanning https://github.com/studyield/studyield, or if clone-studyield.sh
# needs to authenticate (public repo — normally not required).
# GITHUB_TOKEN=

# ── Azure deployment (deploy-azure-aci.sh) ──────────────────────────────────
# AZURE_RESOURCE_GROUP=rg-nuguard-studyield-test
# AZURE_LOCATION=eastus
# ACI_DNS_LABEL=studyield-nuguard-<random-suffix>
# ACR_NAME=nuguardstudyieldacr   # must be globally unique, alphanumeric only

# ── GCP deployment (deploy-gcp-cloudrun.sh) ─────────────────────────────────
# GCP_PROJECT=your-project-id
# GCP_REGION=us-central1
