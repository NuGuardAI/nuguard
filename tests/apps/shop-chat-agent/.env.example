# shop-chat-agent test target — environment template
# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ── AI backend the app uses for chat (Anthropic Claude, direct SDK) ────────
# Required — without it every /chat turn fails with "Authentication failed
# with Claude API" (see app/services/claude.server.js).
CLAUDE_API_KEY=

# ── Shopify app identity ────────────────────────────────────────────────────
# This is a Shopify-embedded app template (OAuth + Shopify CLI dev-store
# tunnel + App Bridge). Real values only matter if you connect it to a real
# Shopify Partner app/dev store (`shopify app dev`, see README). For a local,
# standalone container run (start-local.sh) these can stay as placeholders —
# shopify.server.js only touches them when the /auth/* or /app/* admin routes
# are hit, never on /chat, which is the endpoint NuGuard targets.
SHOPIFY_API_KEY=YOUR_APP_CLIENT_ID
SHOPIFY_API_SECRET=YOUR_APP_CLIENT_SECRET
SCOPES=unauthenticated_read_product_listings
REDIRECT_URL=https://localhost:3458/auth/callback

# ── Container runtime ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── NuGuard's own LLM (scenario generation / judging) ───────────────────────
# Reuse the same LiteLLM-compatible credentials already configured for other
# NuGuard test targets (see ../phlox-app/.env) rather than duplicating secrets.
# AZURE_DEEPSEEK_KEY=
# AZURE_DEEPSEEK_ENDPOINT=
# AZURE_DEEPSEEK_MODEL_NAME=

# ── GitHub (optional) ───────────────────────────────────────────────────────
# Only needed if `nuguard sbom generate` hits GitHub API rate limits while
# scanning https://github.com/Shopify/shop-chat-agent.
# GITHUB_TOKEN=
